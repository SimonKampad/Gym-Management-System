<%- include('../partials/header') %>

<div class="flex min-h-screen">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-8 bg-gym-dark">
        <%- include("../partials/messages") %>

        <div class="mb-10">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-display tracking-tight text-white mb-2">
                        <span class="gradient-text">TRAINER</span> SQUAD
                    </h1>
                    <div class="h-1 w-24 bg-gradient-to-r from-gym-red to-gym-orange rounded-full"></div>
                </div>
            </div>
        </div>

        <div class="bg-gym-gray border border-gym-light rounded-2xl shadow-xl overflow-hidden mb-10">
            <div class="p-6 border-b border-gym-light bg-gradient-to-r from-gym-light to-gym-gray">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-gym-red/10 rounded-lg">
                        <svg class="w-6 h-6 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-display tracking-wide text-white">RECRUIT NEW TRAINER</h2>
                </div>
            </div>

            <form action="/trainers/add" method="POST" class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="flex flex-col">
                        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Trainer Name *</label>
                        <input type="text" name="name" placeholder="Enter name" 
                            class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all placeholder-gray-600" required>
                    </div>

                    <div class="flex flex-col">
                        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Specialty *</label>
                        <input type="text" name="specialty" placeholder="e.g. Bodybuilding" 
                            class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all placeholder-gray-600" required>
                    </div>

                    <div class="flex flex-col">
                        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Phone Number</label>
                        <input type="text" name="contact" placeholder="+91 00000 00000" 
                            class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all placeholder-gray-600">
                    </div>

                    <div class="flex flex-col">
                        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Monthly Salary (₹)</label>
                        <input type="number" name="salary" placeholder="Amount" 
                            class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all placeholder-gray-600">
                    </div>
                </div>

                <div class="flex justify-end mt-8">
                    <button type="submit" 
                        class="bg-gradient-to-r from-gym-red to-gym-orange text-white font-bold px-10 py-3.5 rounded-xl hover:shadow-2xl hover:shadow-gym-red/50 transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] uppercase tracking-wider text-sm">
                        <span class="flex items-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                            <span>Register Trainer</span>
                        </span>
                    </button>
                </div>
            </form>
        </div>

        <div class="bg-gym-gray border border-gym-light rounded-2xl shadow-xl overflow-hidden">
            <div class="p-6 border-b border-gym-light bg-gradient-to-r from-gym-light to-gym-gray">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-gym-red/10 rounded-lg">
                        <svg class="w-6 h-6 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 01-9-3.812"/>
                        </svg>
                    </div>
                    <h2 class="text-xl font-display tracking-wide text-white">ACTIVE TRAINERS</h2>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gym-light border-b border-gym-light">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Trainer Profile</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Specialty</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Contact</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Salary</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gym-light">
                        <% trainers.forEach(trainer => { %>
                        <tr class="hover:bg-gym-light transition-colors group">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <div class="w-12 h-12 bg-gradient-to-br from-gym-red to-gym-orange rounded-xl flex items-center justify-center font-display text-white text-xl flex-shrink-0 group-hover:rotate-6 transition-transform">
                                        <%= trainer.name.charAt(0).toUpperCase() %>
                                    </div>
                                    <span class="font-bold text-white tracking-wide"><%= trainer.name %></span>
                                </div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="inline-flex items-center px-3 py-1 bg-gym-red/10 border border-gym-red/30 rounded-lg">
                                    <span class="text-gym-red font-bold text-xs uppercase tracking-widest"><%= trainer.specialty %></span>
                                </div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-2 text-gray-300">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 004.816 4.816l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <span class="text-sm"><%= trainer.contact || 'N/A' %></span>
                                </div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="text-gym-green font-black text-sm tracking-widest">
                                    ₹<%= trainer.salary %>
                                </div>
                                <div class="text-[10px] text-gray-500 uppercase font-bold">Per Month</div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>