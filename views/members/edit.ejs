<%- include('../partials/header') %>

<div class="flex min-h-screen">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 p-8 bg-gym-dark">
        <!-- Page Header -->
        <div class="mb-10">
            <div class="flex items-center space-x-4 mb-4">
                <a href="/members" class="p-2 bg-gym-light hover:bg-gym-red/20 border border-gym-light rounded-lg transition-all group">
                    <svg class="w-6 h-6 text-gray-400 group-hover:text-gym-red transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                </a>
                <div>
                    <h1 class="text-4xl font-display tracking-tight text-white">
                        <span class="gradient-text">EDIT</span> MEMBER
                    </h1>
                    <div class="h-1 w-24 bg-gradient-to-r from-gym-red to-gym-orange rounded-full mt-2"></div>
                </div>
            </div>
        </div>

        <!-- Edit Form Card -->
        <div class="max-w-3xl">
            <div class="bg-gym-gray border border-gym-light rounded-2xl shadow-xl overflow-hidden">
                <!-- Card Header -->
                <div class="p-6 border-b border-gym-light bg-gradient-to-r from-gym-light to-gym-gray">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-gym-red/10 rounded-lg">
                            <svg class="w-6 h-6 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-display tracking-wide text-white">UPDATE MEMBER DETAILS</h2>
                            <p class="text-xs text-gray-500 mt-1">Modify member information below</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form action="/members/edit/<%= member._id %>" method="POST" class="p-8">
                    <div class="space-y-6">
                        <!-- Full Name -->
                        <div class="flex flex-col">
                            <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide flex items-center space-x-2">
                                <svg class="w-4 h-4 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span>Full Name</span>
                            </label>
                            <input type="text" name="name" value="<%= member.name %>" 
                                class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all" required>
                        </div>

                        <!-- Email Address -->
                        <div class="flex flex-col">
                            <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide flex items-center space-x-2">
                                <svg class="w-4 h-4 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <span>Email Address</span>
                            </label>
                            <input type="email" name="email" value="<%= member.email %>" 
                                class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all" required>
                        </div>

                        <!-- Phone Number -->
                        <div class="flex flex-col">
                            <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide flex items-center space-x-2">
                                <svg class="w-4 h-4 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                <span>Phone Number</span>
                            </label>
                            <input type="text" name="phone" value="<%= member.phone %>" 
                                class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <div class="flex flex-col">
        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Age</label>
        <input type="number" name="age" value="<%= member.age %>" class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red outline-none">
    </div>
    <div class="flex flex-col">
        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Gender</label>
        <select name="gender" class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red outline-none">
            <option value="Male" <%= member.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= member.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= member.gender === 'Other' ? 'selected' : '' %>>Other</option>
        </select>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <div class="flex flex-col">
        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Membership Plan *</label>
        <select name="plan" class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red outline-none" required>
            <% plans.forEach(p => { %>
                <option value="<%= p._id %>" <%= member.plan && member.plan.toString() === p._id.toString() ? 'selected' : '' %>>
                    <%= p.planName %> (₹<%= p.price %>)
                </option>
            <% }) %>
        </select>
    </div>
    <div class="flex flex-col">
        <label class="text-sm font-semibold text-gray-400 mb-2 uppercase tracking-wide">Start Date *</label>
        <input type="date" name="startDate" value="<%= member.startDate.toISOString().split('T')[0] %>" 
            class="bg-gym-light border border-gym-light text-white px-4 py-3.5 rounded-xl focus:border-gym-red outline-none" required>
    </div>
</div>

                    <!-- Action Buttons -->
                    <div class="flex items-center justify-end space-x-4 mt-10 pt-6 border-t border-gym-light">
                        <a href="/members" 
                            class="px-6 py-3 bg-gym-light hover:bg-gym-light/70 border border-gym-light text-gray-300 font-semibold rounded-xl transition-all uppercase tracking-wide text-sm">
                            Cancel
                        </a>
                        <button type="submit" 
                            class="bg-gradient-to-r from-gym-red to-gym-orange text-white font-bold px-10 py-3.5 rounded-xl hover:shadow-2xl hover:shadow-gym-red/50 transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] uppercase tracking-wider text-sm">
                            <span class="flex items-center space-x-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                <span>Update Member</span>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>