<%- include('partials/header') %>

<div class="flex min-h-screen">
    <%- include('partials/sidebar') %>
    
    <main class="flex-1 p-8 bg-gym-dark">
         <button onclick="toggleSidebar()" 
class="lg:hidden mb-6 p-2 bg-gym-light border border-gray-800 rounded-lg text-white hover:bg-gym-red/20 transition-all">

    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
    </svg>
</button>
        <!-- Page Header -->
        <div class="mb-10">
            <h1 class="text-4xl font-display tracking-tight text-white mb-2">
                <span class="gradient-text">DASHBOARD</span> OVERVIEW
            </h1>
            <div class="h-1 w-24 bg-gradient-to-r from-gym-red to-gym-orange rounded-full"></div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Total Members Card -->
            <div class="bg-gym-gray border border-gym-light rounded-2xl p-6 hover-lift relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-gym-red/10 to-transparent rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-500"></div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-gym-red/10 rounded-xl">
                            <svg class="w-6 h-6 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <div class="text-right">
                            <p class="text-gray-500 text-xs uppercase font-bold tracking-wider">Total Members</p>
                            <p class="text-4xl font-display text-white mt-1"><%= memberCount %></p>
                        </div>
                    </div>
                    <div class="h-1 bg-gym-red rounded-full"></div>
                </div>
            </div>

            <!-- Total Trainers Card -->
            <div class="bg-gym-gray border border-gym-light rounded-2xl p-6 hover-lift relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-gym-green/10 to-transparent rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-500"></div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-gym-green/10 rounded-xl">
                            <svg class="w-6 h-6 text-gym-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        <div class="text-right">
                            <p class="text-gray-500 text-xs uppercase font-bold tracking-wider">Total Trainers</p>
                            <p class="text-4xl font-display text-white mt-1"><%= trainerCount %></p>
                        </div>
                    </div>
                    <div class="h-1 bg-gym-green rounded-full"></div>
                </div>
            </div>

            <!-- Active Plans Card -->
            <div class="bg-gym-gray border border-gym-light rounded-2xl p-6 hover-lift relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-500/10 to-transparent rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-500"></div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-purple-500/10 rounded-xl">
                            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                            </svg>
                        </div>
                        <div class="text-right">
                            <p class="text-gray-500 text-xs uppercase font-bold tracking-wider">Active Plans</p>
                            <p class="text-4xl font-display text-white mt-1"><%= planCount %></p>
                        </div>
                    </div>
                    <div class="h-1 bg-purple-500 rounded-full"></div>
                </div>
            </div>

            <!-- Revenue Card -->
            <div class="bg-gym-gray border border-gym-light rounded-2xl p-6 hover-lift relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-gym-orange/10 to-transparent rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-500"></div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-4">
                        <div class="p-3 bg-gym-orange/10 rounded-xl">
                            <svg class="w-6 h-6 text-gym-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div class="text-right">
                            <p class="text-gray-500 text-xs uppercase font-bold tracking-wider">Est. Revenue</p>
                            <p class="text-4xl font-display text-white mt-1">₹<%= totalRevenue %></p>
                        </div>
                    </div>
                    <div class="h-1 bg-gym-orange rounded-full"></div>
                </div>
            </div>
        </div>

        <!-- Recent Members Section -->
        <div class="bg-gym-gray border border-gym-light rounded-2xl shadow-xl overflow-hidden">
            <!-- Header -->
            <div class="p-6 border-b border-gym-light bg-gradient-to-r from-gym-light to-gym-gray">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="p-2 bg-gym-red/10 rounded-lg">
                            <svg class="w-6 h-6 text-gym-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 01-9-3.812"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-display tracking-wide text-white">RECENT MEMBERS</h3>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gym-light border-b border-gym-light">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Name</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Join Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gym-light">
                        <% recentMembers.forEach((member, index) => { %>
                            <tr class="hover:bg-gym-light transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 bg-gradient-to-br from-gym-red to-gym-orange rounded-full flex items-center justify-center font-display text-white text-lg">
                                            <%= member.name.charAt(0).toUpperCase() %>
                                        </div>
                                        <span class="text-sm font-semibold text-white group-hover:text-gym-red transition-colors"><%= member.name %></span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-gray-400"><%= member.email %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <span class="text-sm text-gray-500">
                                            <%= member.startDate ? member.startDate.toDateString() : 'No Date' %>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            <div class="p-5 bg-gym-light border-t border-gym-light text-center">
                <a href="/members" class="inline-flex items-center space-x-2 text-gym-red font-bold text-sm hover:text-gym-orange transition-colors group">
                    <span class="uppercase tracking-wider">View All Members</span>
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </a>
            </div>
        </div>
    </main>
</div>

<%- include('partials/footer') %>