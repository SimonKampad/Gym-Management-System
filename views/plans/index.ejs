<%- include('../partials/header') %>

<div class="flex min-h-screen">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 p-8 bg-gym-dark">
        <%- include("../partials/messages") %>

        <div class="mb-10">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-display tracking-tight text-white mb-2">
                        <span class="gradient-text">PRICING</span> ARCHIVE
                    </h1>
                    <div class="h-1 w-24 bg-gradient-to-r from-gym-red to-gym-orange rounded-full"></div>
                </div>
            </div>
        </div>

        <div class="bg-gym-gray border border-gym-light rounded-2xl shadow-xl overflow-hidden mb-12">
            <div class="p-5 border-b border-gym-light bg-gradient-to-r from-gym-light to-gym-gray">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-gym-red/10 rounded-lg text-gym-red">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                    </div>
                    <h2 class="text-lg font-display tracking-wide text-white uppercase">Add New Strategy</h2>
                </div>
            </div>

            <form action="/plans/add" method="POST" class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="flex flex-col">
                        <label class="text-xs font-bold text-gray-500 mb-2 uppercase">Plan Title</label>
                        <input type="text" name="planName" placeholder="e.g. Pro Athlete" class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all" required>
                    </div>
                    <div class="flex flex-col">
                        <label class="text-xs font-bold text-gray-500 mb-2 uppercase">Price (INR)</label>
                        <input type="number" name="price" placeholder="2999" class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all" required>
                    </div>
                    <div class="flex flex-col">
                        <label class="text-xs font-bold text-gray-500 mb-2 uppercase">Days</label>
                        <input type="number" name="durationInDays" placeholder="30" class="bg-gym-light border border-gym-light text-white px-4 py-3 rounded-xl focus:border-gym-red focus:ring-2 focus:ring-gym-red/20 outline-none transition-all" required>
                    </div>
                </div>
                <div class="flex justify-end mt-6">
                    <button type="submit" class="bg-gradient-to-r from-gym-red to-gym-orange text-white font-black px-8 py-3 rounded-xl hover:shadow-lg hover:shadow-gym-red/40 transition-all transform hover:-translate-y-1 uppercase text-xs tracking-widest">
                        Publish Plan
                    </button>
                </div>
            </form>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% plans.forEach(plan => { %>
                <div class="relative bg-gym-gray border border-gym-light rounded-3xl p-8 hover:border-gym-red/50 transition-all duration-500 group overflow-hidden">
                    <div class="absolute -right-4 -top-4 w-24 h-24 bg-gym-red/5 rounded-full blur-3xl group-hover:bg-gym-red/20 transition-all"></div>
                    
                    <div class="relative z-10">
                        <div class="flex justify-between items-start mb-6">
                            <div class="p-3 bg-gym-light rounded-2xl text-gym-red group-hover:scale-110 transition-transform duration-500">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            </div>
                            <a href="/plans/delete/<%= plan._id %>" onclick="return confirm('Delete this plan?')" class="text-gray-600 hover:text-red-500 transition-colors p-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </a>
                        </div>

                        <h3 class="text-2xl font-display font-bold text-white mb-2 uppercase tracking-tight">
                            <%= plan.planName %>
                        </h3>
                        
                        <div class="flex items-baseline mb-6">
                            <span class="text-4xl font-black text-white">₹<%= plan.price %></span>
                            <span class="text-gray-500 ml-2 text-sm font-semibold uppercase tracking-widest">/ <%= plan.durationInDays %> Days</span>
                        </div>

                        <ul class="space-y-4 mb-8">
                            <li class="flex items-center text-sm text-gray-400">
                                <svg class="w-4 h-4 mr-3 text-gym-green" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg>
                                Full Gym Access
                            </li>
                            <li class="flex items-center text-sm text-gray-400">
                                <svg class="w-4 h-4 mr-3 text-gym-green" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg>
                                Digital Membership Tracking
                            </li>
                        </ul>

                        <div class="pt-6 border-t border-gym-light">
                            <div class="flex items-center justify-between text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em]">
                                <span>Code: <%= plan._id.toString().slice(-6) %></span>
                                <span class="text-gym-orange">Premium Tier</span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>