        { name: 'Cable Chest Fly', sets: '3 Sets x 15 Reps', img: 'https://i0.wp.com/www.strengthlog.com/wp-content/uploads/2020/03/cable-chest-fly.gif?resize=600%2C600&ssl=1' },
