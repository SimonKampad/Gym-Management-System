function showWorkout(category) {
    const modal = document.getElementById('workoutModal');
    const title = document.getElementById('modalTitle');
    const list = document.getElementById('exerciseList');
    
    title.innerText = `${category.toUpperCase()} ROUTINE`;
    list.innerHTML = '';

    if(workoutData[category]) {
        workoutData[category].forEach(ex => {
            list.innerHTML += `
                <div class="bg-gym-light p-4 rounded-2xl flex items-center space-x-4">
                    <img src="${ex.img}" class="w-24 h-24 rounded-xl object-cover border border-gym-light" />
                    <div>
                        <h4 class="text-white font-bold">${ex.name}</h4>
                        <p class="text-gym-red text-xs font-bold uppercase mt-1">${ex.sets}</p>
                    </div>
                </div>
            `;
        });
    } else {
        list.innerHTML = '<p class="text-gray-500">Workout details coming soon for this category!</p>';
    }

    modal.classList.remove('hidden');
}

function closeModal() {
    document.getElementById('workoutModal').classList.add('hidden');
}
</script>
<%- include('../partials/footer') %>