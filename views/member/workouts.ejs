<%- include('../partials/header') %>
<div class="min-h-screen bg-gym-dark p-6">
    <div class="max-w-4xl mx-auto">
        <div class="mb-10">
            <h1 class="text-4xl font-display text-white mb-2">WORKOUT <span class="gradient-text">LIBRARY</span></h1>
            <p class="text-gray-400">Select a muscle group to view expert-guided exercises.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% categories.forEach(cat => { %>
                <div onclick="showWorkout('<%= cat %>')" class="group relative overflow-hidden rounded-3xl bg-gym-gray border border-gym-light p-1 cursor-pointer hover:border-gym-red transition-all duration-300">
                    <div class="p-6">
                        <div class="w-12 h-12 bg-gym-red/10 rounded-2xl flex items-center justify-center mb-4 group-hover:bg-gym-red transition-colors">
                            <svg class="w-6 h-6 text-gym-red group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-display text-white tracking-wide uppercase"><%= cat %></h3>
                        <p class="text-xs text-gray-500 mt-1">View 10+ Exercises</p>
                    </div>
                </div>
            <% }) %>
        </div>

        <div id="workoutModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/90 backdrop-blur-sm">
            <div class="bg-gym-gray w-full max-w-2xl rounded-3xl overflow-hidden border border-gym-light">
                <div class="p-6 border-b border-gym-light flex justify-between items-center">
                    <h2 id="modalTitle" class="text-2xl font-display text-white tracking-wider">CHEST WORKOUT</h2>
                    <button onclick="closeModal()" class="text-gray-400 hover:text-white">&times; Close</button>
                </div>
                <div id="exerciseList" class="p-6 max-h-[70vh] overflow-y-auto space-y-6">
                    </div>
            </div>
        </div>
    </div>
</div>

