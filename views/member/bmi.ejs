<%- include('../partials/header') %>
<div class="min-h-screen bg-gym-dark p-6">
    <div class="max-w-2xl mx-auto">
        <a href="/member/dashboard" class="text-gym-red flex items-center mb-6 hover:underline">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
            Back to Dashboard
        </a>

        <div class="bg-gym-gray border border-gym-light rounded-3xl p-8 shadow-2xl">
            <h1 class="text-3xl font-display text-white mb-2">BMI <span class="gradient-text">CALCULATOR</span></h1>
            <p class="text-gray-400 mb-8 text-sm">Monitor your body mass index to stay on track.</p>

            <div class="space-y-6">
                <div>
                    <label class="block text-gray-400 text-xs font-bold uppercase mb-2">Weight (kg)</label>
                    <input type="number" id="weight" placeholder="e.g. 70" class="w-full bg-gym-light border border-gym-light rounded-xl p-4 text-white focus:border-gym-red outline-none">
                </div>
                <div>
                    <label class="block text-gray-400 text-xs font-bold uppercase mb-2">Height (cm)</label>
                    <input type="number" id="height" placeholder="e.g. 175" class="w-full bg-gym-light border border-gym-light rounded-xl p-4 text-white focus:border-gym-red outline-none">
                </div>
                <button onclick="calculateBMI()" class="w-full bg-gradient-to-r from-gym-red to-gym-orange text-white font-bold py-4 rounded-xl uppercase tracking-widest hover:opacity-90 transition-all">
                    Calculate Now
                </button>
            </div>

            <div id="resultCard" class="hidden mt-10 p-6 bg-gym-light rounded-2xl border-l-4 border-gym-red">
                <p class="text-gray-400 text-xs uppercase font-bold">Your Result</p>
                <div class="flex items-center justify-between mt-2">
                    <h2 id="bmiValue" class="text-4xl font-black text-white">24.5</h2>
                    <span id="bmiStatus" class="px-4 py-1 bg-gym-red text-white text-[10px] font-bold rounded-full uppercase">Normal</span>
                </div>
                <p id="bmiMsg" class="text-gray-400 text-sm mt-4 italic">"You are in a healthy weight range. Keep it up!"</p>
            </div>
        </div>
    </div>
</div>

<script>
function calculateBMI() {
    const w = document.getElementById('weight').value;
    const h = document.getElementById('height').value / 100; // convert cm to m

    if(w > 0 && h > 0) {
        const bmi = (w / (h * h)).toFixed(1);
        document.getElementById('bmiValue').innerText = bmi;
        document.getElementById('resultCard').classList.remove('hidden');

        let status = "";
        let msg = "";

        if(bmi < 18.5) { status = "Underweight"; msg = "Time to bulk up! Focus on protein and strength training."; }
        else if(bmi < 25) { status = "Normal"; msg = "Great job! You are in the healthy range."; }
        else if(bmi < 30) { status = "Overweight"; msg = "Let's burn some calories! Focus on cardio and consistent diet."; }
        else { status = "Obese"; msg = "Don't give up! Consistency is key. Consult your trainer for a plan."; }

        document.getElementById('bmiStatus').innerText = status;
        document.getElementById('bmiMsg').innerText = `"${msg}"`;
    }
}
</script>
<%- include('../partials/footer') %>